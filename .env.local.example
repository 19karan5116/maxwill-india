# Environment variables for MAXWILL INDIA
# Copy this file to .env.local and update values

# Site Configuration
NEXT_PUBLIC_SITE_NAME=MAXWILL INDIA
NEXT_PUBLIC_SITE_DESCRIPTION=Premium Pickleball Equipment
NEXT_PUBLIC_SITE_URL=https://www.maxwill-india.com
NEXT_PUBLIC_SITE_LOCALE=en-IN

# Feature Flags
NEXT_PUBLIC_ENABLE_ANIMATIONS=true
NEXT_PUBLIC_MAINTENANCE_MODE=false

# API Endpoints (Future Bubble integration)
# NEXT_PUBLIC_API_URL=https://api.bubble.com/api/1.1/wf
# BUBBLE_API_KEY=your_bubble_api_key_here

# Analytics (Future)
# NEXT_PUBLIC_GA_ID=UA_YOUR_ID

# CMS (Future)
# NEXT_PUBLIC_CMS_URL=https://cms.maxwill-india.com
